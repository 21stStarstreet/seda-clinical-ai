@code {
    private HealthResponse? _health;
    private List<AuditLogEntry> _loglar = [];
    private bool _loglarYuklendi = false;

    protected override async Task OnInitializedAsync()
    {
        _health = await ApiService.GetHealthAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // ProtectedSessionStorage sadece SignalR bağlantısı kurulduktan sonra
        // erişilebilir, bu yüzden logları OnAfterRenderAsync'te çekiyoruz.
        _loglar = await ApiService.GetLogsAsync(limit: 500);
        _loglarYuklendi = true;
        StateHasChanged();
    }

    private static string MaskId(string? id)
    {
        if (string.IsNullOrEmpty(id)) return "—";
        if (id.Length <= 4) return id;
        return id[..2] + new string('*', id.Length - 4) + id[^2..];
    }

    private static string FormatTarih(string ts)
    {
        if (DateTime.TryParse(ts, out var dt))
            return dt.ToString("dd.MM.yyyy HH:mm");
        return ts;
    }

    private static RenderFragment KararBadge(bool karar) => karar
        ? @<span class="badge-evet"><i class="ph-bold ph-check"></i></span>
        : @<span class="badge-hayir"><i class="ph-bold ph-x"></i></span>;
}
