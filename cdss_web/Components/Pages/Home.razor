        <div class="stat-label">Toplam Karar (Tümü)</div>
    </div>-->
</div>

<!-- ─── Klinik İstatistikler (Gerçek Veriler) ────────────────────────────── -->
@if (_loglar.Count > 0)
{
    var bugun = _loglar.Count(l => DateTime.TryParse(l.Timestamp, out var d) && d.Date == DateTime.Today);
    var buHafta = _loglar.Count(l => DateTime.TryParse(l.Timestamp, out var d) && d >= DateTime.Today.AddDays(-7));
    var ftrOran = (double)_loglar.Count(l => l.Tahmin?.Ftr == true) / _loglar.Count * 100;
    var aileOran = (double)_loglar.Count(l => l.Tahmin?.AileHekimligi == true) / _loglar.Count * 100;
    var sistemikOran = (double)_loglar.Count(l => l.Tahmin?.SistemikTedavi == true) / _loglar.Count * 100;

    <div class="card fade-in" style="margin-bottom:20px;">
        <div class="card-title" style="margin-bottom:16px;"><i class="ph ph-chart-bar" style="margin-right:8px;"></i>Karar Dağılımı</div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:20px;">
            <!-- Bugün -->
            <div class="home-mini-card">
                <div class="mini-card-value" style="color:var(--accent);">@bugun</div>
                <div class="mini-card-label">Bugün</div>
            </div>
            <!-- Bu Hafta -->
            <div class="home-mini-card">
                <div class="mini-card-value" style="color:#818CF8;">@buHafta</div>
                <div class="mini-card-label">Bu Hafta</div>
            </div>
            <!-- Toplam -->
            <div class="home-mini-card">
                <div class="mini-card-value" style="color:var(--text-primary);">@_loglar.Count</div>
                <div class="mini-card-label">Toplam</div>
            </div>
        </div>

        <!-- Birim bazlı oran barları -->
        <div style="display:flex;flex-direction:column;gap:12px;">
            <div class="home-stat-row">
                <span class="home-stat-label"><i class="ph-duotone ph-person-simple-walk" style="margin-right:4px;"></i>FTR Önerilen</span>
                <div class="prob-bar-bg" style="flex:1;margin:0 12px;">
                    <div class="prob-bar-fill positive-fill" style="width:@((int)ftrOran)%"></div>
                </div>
                <span class="home-stat-pct">%@((int)ftrOran) — @_loglar.Count(l => l.Tahmin?.Ftr == true) hasta</span>
            </div>
            <div class="home-stat-row">
                <span class="home-stat-label"><i class="ph-duotone ph-hospital" style="margin-right:4px;"></i>Aile Hek. Önerilen</span>
                <div class="prob-bar-bg" style="flex:1;margin:0 12px;">
                    <div style="height:100%;border-radius:inherit;background:#818CF8;width:@((int)aileOran)%;transition:width 0.6s ease;"></div>
                </div>
                <span class="home-stat-pct">%@((int)aileOran) — @_loglar.Count(l => l.Tahmin?.AileHekimligi == true) hasta</span>
            </div>
            <div class="home-stat-row">
                <span class="home-stat-label"><i class="ph-duotone ph-pill" style="margin-right:4px;"></i>Sistemik Tedavi</span>
                <div class="prob-bar-bg" style="flex:1;margin:0 12px;">
                    <div style="height:100%;border-radius:inherit;background:var(--warning);width:@((int)sistemikOran)%;transition:width 0.6s ease;"></div>
                </div>
                <span class="home-stat-pct">%@((int)sistemikOran) — @_loglar.Count(l => l.Tahmin?.SistemikTedavi == true) hasta</span>
            </div>
        </div>
    </div>

    <!-- ─── Son 5 Karar ──────────────────────────────────────────────────── -->
    <div class="card fade-in" style="margin-bottom:20px;">
        <div class="card-title" style="margin-bottom:12px;"><i class="ph-duotone ph-clock" style="margin-right:6px;"></i>Son Kararlar</div>
        <table class="audit-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tarih / Saat</th>
                    <th>Hasta Adı / ID</th>
                    <th>FTR</th>
                    <th>Aile Hek.</th>
                    <th>Sistemik</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in _loglar.OrderByDescending(l => l.Id).Take(5))
                {
                    <tr>
                        <td class="audit-id">#@log.Id</td>
                        <td class="audit-time">@FormatTarih(log.Timestamp)</td>
                        <td class="audit-hasta">@(!string.IsNullOrEmpty(log.HastaAdi) ? log.HastaAdi : MaskId(log.HastaId))</td>
                        <td>@KararBadge(log.Tahmin?.Ftr == true)</td>
                        <td>@KararBadge(log.Tahmin?.AileHekimligi == true)</td>
                        <td>@KararBadge(log.Tahmin?.SistemikTedavi == true)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_loglarYuklendi)
{
    <!-- İlk kez kullanım -->
    <div class="card fade-in" style="margin-bottom:20px;text-align:center;padding:40px;">
        <div style="font-size:40px;margin-bottom:12px;"><i class="ph ph-flask"></i></div>
        <p style="color:var(--text-muted);">Henüz hiç karar alınmamış. İlk değerlendirmeyi yapmak için <a href="/degerlendirme" style="color:var(--accent);">buraya tıklayın</a>.</p>
    </div>
}
