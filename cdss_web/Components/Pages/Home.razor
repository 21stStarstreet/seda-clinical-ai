        <div class="stat-value" style="color: @(_health?.LlmAktif == true ? "var(--success)" : "var(--text-muted)")">
            @(_health?.LlmAktif == true ? "Aktif" : "Pasif")
        </div>
        <div class="stat-label">LLM Açıklama Motoru</div>
    </div>
    <div class="stat-card">
