<!-- ─── Sistem Durumu Kartları ─────────────────────────────────────────────── -->
<div class="stats-grid fade-in" style="margin-bottom:20px;">
    <!--<div class="stat-card">
        <div class="stat-icon"><i class="ph ph-robot"></i></div>
        <div class="stat-value">@(_health?.ModelVersiyonu ?? "—")</div>
