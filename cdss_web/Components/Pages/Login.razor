@page "/login"
@layout EmptyLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Giriş — SEDA</PageTitle>

<div class="login-split-wrapper">

    <div class="login-split-left">
        <div class="login-split-brand" style="display:flex; flex-direction:column; align-items:flex-start;">
            <img src="seda-logo.jpg?v=2.1" alt="SEDA Logo" class="login-split-logo" />
            <span class="seda-animated-logo-text">SEDA</span>
            <span class="seda-animated-subtitle">SEDEF DESTEK ALGORİTMASI</span>
        </div>

        <div class="login-split-hero">
            <h1 class="login-split-title">Psoriazis Yönlendirme<br />Sistemi</h1>
            <p class="login-split-subtitle">
                Hastanın klinik bulgularını analiz ederek Sistemik Tedavi, FTR veya Aile Hekimliği ihtiyacını saniyeler içinde değerlendiren yapay zeka tabanlı karar destek asistanınız.
            </p>

            <!-- ─── Sıvı Cam Segmentli Kaydırıcı (Pulsar Glass Slider) ─── -->
            <div class="login-routing-slider-wrap">
                <div class="rag-segmented-track login-routing-track" id="loginRoutingTrack">
                    <div class="rag-active-slider" id="loginRoutingSlider"></div>
                    <button type="button" class="rag-pill-btn @(_aktifYonlendirme == "sistemik" ? "active" : "")"
                            @onclick='() => SetYonlendirme("sistemik")'>
                        <span class="rag-pill-label">
                            <i class="ph-bold ph-pill"></i> Sistemik Tedavi
                        </span>
                    </button>
                    <button type="button" class="rag-pill-btn @(_aktifYonlendirme == "ftr" ? "active" : "")"
                            @onclick='() => SetYonlendirme("ftr")'>
                        <span class="rag-pill-label">
                            <i class="ph-bold ph-person-arms-spread"></i> FTR &amp; Romatoloji
                        </span>
                    </button>
                    <button type="button" class="rag-pill-btn @(_aktifYonlendirme == "aile" ? "active" : "")"
                            @onclick='() => SetYonlendirme("aile")'>
                        <span class="rag-pill-label">
                            <i class="ph-bold ph-heartbeat"></i> Aile Hekimliği
                        </span>
                    </button>
                </div>
            </div>

            <!-- ─── Dinamik Seçili Yönlendirme Kartı (Yapılandırılmış Klinik Karar Matrisi) ─── -->
            <div class="login-routing-card-container">
                @if (_aktifYonlendirme == "sistemik")
                {
                    <div class="login-routing-card card-sistemik fade-in">
                        <div class="login-routing-card-header">
                            <div class="login-routing-header-left">
                                <div class="login-routing-icon-box box-sistemik">
                                    <i class="ph-duotone ph-pill"></i>
                                </div>
                                <div class="login-routing-title-wrap">
                                    <h3 class="login-routing-title">Sistemik &amp; Biyolojik Tedavi</h3>
                                    <span class="login-routing-sub">Orta-Ağır Plak Psoriazis Karar Protokolü</span>
                                </div>
                            </div>
                            <div class="login-routing-score score-sistemik">F1 · 0.996 · %98.4 Doğruluk</div>
                        </div>

                        <p class="login-routing-desc">
                            Konvansiyonel sistemik ilaçlar ve hedefe yönelik biyolojik ajanların (Anti-IL17, IL-23, TNF-α) endikasyon, kontrendikasyon ve basamaklı geçiş kriterlerini değerlendirir.
                        </p>

                        <!-- Algoritmik Tetikleyici Eşikler (Chips) -->
                        <div class="login-routing-triggers">
                            <div class="triggers-heading">
                                <i class="ph-bold ph-target"></i> Algoritmik Karar Eşikleri
                            </div>
                            <div class="triggers-grid">
                                <span class="trigger-chip chip-sistemik"><i class="ph-bold ph-check"></i> PASI &gt; 10</span>
                                <span class="trigger-chip chip-sistemik"><i class="ph-bold ph-check"></i> DLQI &gt; 10</span>
                                <span class="trigger-chip chip-sistemik"><i class="ph-bold ph-check"></i> BSA &gt; %10</span>
                                <span class="trigger-chip chip-sistemik"><i class="ph-bold ph-warning-circle"></i> Dirençli Özel Bölge</span>
                            </div>
                        </div>

                        <!-- 2 Kolonlu Yapılandırılmış Klinik Matris -->
                        <div class="login-routing-matrix">
                            <div class="matrix-col">
                                <div class="matrix-title">
                                    <i class="ph-bold ph-sliders-horizontal"></i> İncelenen Klinik Belirteçler
                                </div>
                                <ul class="matrix-list">
                                    <li><i class="ph-bold ph-caret-right"></i> Lezyon yaygınlığı ve şiddeti (PASI/BSA)</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Yaşam kalitesi ve psikososyal etki (DLQI)</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Önceki tedavi yanıtı ve basamak direnci</li>
                                </ul>
                            </div>
                            <div class="matrix-col">
                                <div class="matrix-title">
                                    <i class="ph-bold ph-shield-check"></i> Hedef Çıktı &amp; Standart
                                </div>
                                <ul class="matrix-list">
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Biyolojik/Sistemik basamak uygunluk onayı</li>
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Karaciğer, böbrek ve enfeksiyon güvenlik denetimi</li>
                                </ul>
                                <div class="matrix-guidelines">
                                    <span class="badge-guideline">🇹🇷 TR PSOKİD 2025</span>
                                    <span class="badge-guideline">🇪🇺 EuroGuiDerm</span>
                                </div>
                            </div>
                        </div>

                        <!-- Doğrulama & Güvenilirlik Alt Bilgisi -->
                        <div class="login-routing-footer">
                            <i class="ph-bold ph-certificate"></i>
                            <span>DCPR &amp; 104 Haftalık Gerçek Yaşam Kohortu ile Eğitildi ve Doğrulandı</span>
                        </div>
                    </div>
                }
                else if (_aktifYonlendirme == "ftr")
                {
                    <div class="login-routing-card card-ftr fade-in">
                        <div class="login-routing-card-header">
                            <div class="login-routing-header-left">
                                <div class="login-routing-icon-box box-ftr">
                                    <i class="ph-duotone ph-person-arms-spread"></i>
                                </div>
                                <div class="login-routing-title-wrap">
                                    <h3 class="login-routing-title">Fizik Tedavi &amp; Romatoloji</h3>
                                    <span class="login-routing-sub">Erken Psöriatik Artrit (PsA) &amp; Eklem Hasarı Protokolü</span>
                                </div>
                            </div>
                            <div class="login-routing-score score-ftr">F1 · 0.972 · %96.8 Doğruluk</div>
                        </div>

                        <p class="login-routing-desc">
                            Psöriatik artrit (PsA), aksiyel tutulum ve periferik eklem hasarını kalıcı erozyon gelişmeden önce erken evrede tespit ederek multidisipliner konsültasyon ihtiyacını belirler.
                        </p>

                        <!-- Algoritmik Tetikleyici Eşikler (Chips) -->
                        <div class="login-routing-triggers">
                            <div class="triggers-heading">
                                <i class="ph-bold ph-target"></i> Algoritmik Karar Eşikleri
                            </div>
                            <div class="triggers-grid">
                                <span class="trigger-chip chip-ftr"><i class="ph-bold ph-clock"></i> Sabah Tutukluğu &gt; 30 dk</span>
                                <span class="trigger-chip chip-ftr"><i class="ph-bold ph-check"></i> CASPAR &ge; 3</span>
                                <span class="trigger-chip chip-ftr"><i class="ph-bold ph-warning-circle"></i> Daktilit (Sosis Parmak)</span>
                                <span class="trigger-chip chip-ftr"><i class="ph-bold ph-warning-circle"></i> Tırnak Tutulumu (NAPSI)</span>
                            </div>
                        </div>

                        <!-- 2 Kolonlu Yapılandırılmış Klinik Matris -->
                        <div class="login-routing-matrix">
                            <div class="matrix-col">
                                <div class="matrix-title">
                                    <i class="ph-bold ph-sliders-horizontal"></i> İncelenen Klinik Belirteçler
                                </div>
                                <ul class="matrix-list">
                                    <li><i class="ph-bold ph-caret-right"></i> İnflamatuar periferik ve aksiyel eklem ağrısı</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Sabah tutukluğu süresi ve daktilit öyküsü</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Tırnak distrofisi ve matriks tutulumu (NAPSI)</li>
                                </ul>
                            </div>
                            <div class="matrix-col">
                                <div class="matrix-title">
                                    <i class="ph-bold ph-shield-check"></i> Hedef Çıktı &amp; Standart
                                </div>
                                <ul class="matrix-list">
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Erken Romatoloji/FTR konsültasyon sevk önceliği</li>
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Eklem hasarını önleyici hedefe yönelik tedavi planı</li>
                                </ul>
                                <div class="matrix-guidelines">
                                    <span class="badge-guideline">CASPAR Kriterleri</span>
                                    <span class="badge-guideline">EULAR / GRAPPA 2024</span>
                                </div>
                            </div>
                        </div>

                        <!-- Doğrulama & Güvenilirlik Alt Bilgisi -->
                        <div class="login-routing-footer">
                            <i class="ph-bold ph-certificate"></i>
                            <span>EULAR / GRAPPA Klinik Konsensüs Karar Ağacı ile Doğrulandı</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="login-routing-card card-aile fade-in">
                        <div class="login-routing-card-header">
                            <div class="login-routing-header-left">
                                <div class="login-routing-icon-box box-aile">
                                    <i class="ph-duotone ph-heartbeat"></i>
                                </div>
                                <div class="login-routing-title-wrap">
                                    <h3 class="login-routing-title">Aile Hekimliği &amp; Komorbidite</h3>
                                    <span class="login-routing-sub">Kardiyometabolik Risk &amp; Birinci Basamak İzlemi</span>
                                </div>
                            </div>
                            <div class="login-routing-score score-aile">F1 · 0.954 · %95.1 Doğruluk</div>
                        </div>

                        <p class="login-routing-desc">
                            Psoriazisin kronik sistemik inflamatuar yapısı gereği tetiklenen kardiyometabolik riskleri, karaciğer fonksiyonlarını ve metabolik sendrom bileşenlerini koordine eder.
                        </p>

                        <!-- Algoritmik Tetikleyici Eşikler (Chips) -->
                        <div class="login-routing-triggers">
                            <div class="triggers-heading">
                                <i class="ph-bold ph-target"></i> Algoritmik Karar Eşikleri
                            </div>
                            <div class="triggers-grid">
                                <span class="trigger-chip chip-aile"><i class="ph-bold ph-warning"></i> VKİ &ge; 30 kg/m²</span>
                                <span class="trigger-chip chip-aile"><i class="ph-bold ph-warning"></i> LDL &gt; 130 mg/dL</span>
                                <span class="trigger-chip chip-aile"><i class="ph-bold ph-check"></i> Aktif Sigara</span>
                                <span class="trigger-chip chip-aile"><i class="ph-bold ph-heart"></i> Kardiyovasküler Risk</span>
                            </div>
                        </div>

                        <!-- 2 Kolonlu Yapılandırılmış Klinik Matris -->
                        <div class="login-routing-matrix">
                            <div class="matrix-col">
                                <div class="matrix-title">
                                    <i class="ph-bold ph-sliders-horizontal"></i> İncelenen Klinik Belirteçler
                                </div>
                                <ul class="matrix-list">
                                    <li><i class="ph-bold ph-caret-right"></i> Vücut Kitle İndeksi (VKİ) ve obezite evresi</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Serum lipid paneli (LDL/HDL/Trigliserit)</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Karaciğer enzimleri (ALT/AST), sigara ve yaş</li>
                                </ul>
                            </div>
                            <div class="matrix-col">
                                <div class="matrix-title">
                                    <i class="ph-bold ph-shield-check"></i> Hedef Çıktı &amp; Standart
                                </div>
                                <ul class="matrix-list">
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Birinci basamak metabolik takip ve statin protokolü</li>
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Sistemik ilaç hepatotoksisite ve risk yönetimi</li>
                                </ul>
                                <div class="matrix-guidelines">
                                    <span class="badge-guideline">Türkiye KMR Kılavuzu</span>
                                    <span class="badge-guideline">DSÖ Kardiyometabolik</span>
                                </div>
                            </div>
                        </div>

                        <!-- Doğrulama & Güvenilirlik Alt Bilgisi -->
                        <div class="login-routing-footer">
                            <i class="ph-bold ph-certificate"></i>
                            <span>Kardiyometabolik Risk Yönetimi Algoritması ile Doğrulandı</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="login-split-watermark">
            <i class="ph ph-first-aid"></i>
        </div>
    </div>
 
    <div class="login-split-right">
        <div class="login-top-actions">
            <div class="rag-segmented-track login-theme-track" id="loginThemeTrack">
                <div class="rag-active-slider" id="loginActiveSlider"></div>
                <button type="button" class="rag-pill-btn @(_isDarkTheme ? "active" : "")"
                        @onclick="() => SetTheme(true)" title="Koyu Tema">
                    <span class="rag-pill-label">
                        <i class="ph-bold ph-moon"></i> Koyu
                    </span>
                </button>
                <button type="button" class="rag-pill-btn @(!_isDarkTheme ? "active" : "")"
                        @onclick="() => SetTheme(false)" title="Açık Tema">
                    <span class="rag-pill-label">
                        <i class="ph-bold ph-sun"></i> Açık
                    </span>
                </button>
            </div>
        </div>

        <div class="login-split-form-wrap">

            @if (_reason == "timeout")
            {
                <div class="login-banner login-banner--warning">
                    <i class="ph ph-clock"></i>
                    <span>Oturumunuz 30 dakika hareketsizlik nedeniyle sonlandırıldı.</span>
                </div>
            }
            else if (_reason == "unauthorized")
            {
                <div class="login-banner login-banner--error">
                    <i class="ph ph-lock"></i>
                    <span>Bu sayfaya erişmek için önce giriş yapmanız gerekiyor.</span>
                </div>
            }
            else if (_reason == "logout")
            {
                <div class="login-banner login-banner--success">
                    <i class="ph ph-check-circle"></i>
                    <span>Oturumunuz başarıyla sonlandırıldı. Güle güle!</span>
                </div>
            }

            <h2 class="login-split-heading">Hoş Geldiniz</h2>
            <p class="login-split-sub">Hesabınıza giriş yapın</p>

            @if (!string.IsNullOrEmpty(_hataMesaji))
            {
                <div class="login-banner login-banner--error" style="margin-bottom:20px;">
                    <i class="ph ph-warning"></i>
                    <span>@_hataMesaji</span>
                </div>
            }

            <EditForm Model="_form" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="login-underline-field">
                    <label class="login-underline-label">Kullanıcı Adı</label>
                    <InputText class="login-underline-input"
                               placeholder="kullanici.adi"
                               @bind-Value="_form.KullaniciAdi"
                               autocomplete="username" />
                    <ValidationMessage For="@(() => _form.KullaniciAdi)" />
                </div>

                <div class="login-underline-field">
                    <label class="login-underline-label">Şifre</label>
                    <input class="login-underline-input"
                           type="password"
                           placeholder="••••••••"
                           @bind="_form.Sifre"
                           @bind:event="oninput"
                           autocomplete="current-password" />
                </div>

                <button type="submit" class="login-split-btn" disabled="@_yukleniyor">
                    @if (_yukleniyor)
                    {
                        <span class="spinner" style="width:16px;height:16px;border-width:2px;border-color:rgba(255,255,255,0.3);border-top-color:#fff;"></span>
                        <span>Giriş yapılıyor…</span>
                    }
                    else
                    {
                        <span>Giriş Yap</span>
                        <i class="ph ph-arrow-right"></i>
                    }
                </button>
            </EditForm>

            <div class="login-split-security">
                <i class="ph ph-lock-simple"></i>
                <span>Güvenli bağlantı &middot; SSL şifreli</span>
            </div>
        </div>
    </div>
</div>

<style>
    .login-routing-slider-wrap {
        margin-bottom: 16px;
        width: 100%;
        max-width: 520px;
    }
    .login-routing-track.rag-segmented-track {
        width: 100%;
        display: flex;
        padding: 3px;
        border-radius: 13px;
        box-sizing: border-box;
    }
    .login-routing-track .rag-pill-btn {
        flex: 1;
        padding: 8px 10px;
        min-width: 0;
        font-size: 12.5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        cursor: pointer;
    }
    .login-routing-track .rag-pill-label {
        gap: 6px;
        white-space: nowrap;
    }
    .login-routing-track .rag-pill-label i {
        font-size: 14.5px;
    }
    .login-routing-card-container {
        width: 100%;
        max-width: 530px;
    }
    .login-routing-card {
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(24px) saturate(190%);
        -webkit-backdrop-filter: blur(24px) saturate(190%);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-top: 1.5px solid rgba(255, 255, 255, 0.25);
        border-radius: 16px;
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.45);
        box-sizing: border-box;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card-sistemik { border-left: 4px solid #10b981; }
    .card-ftr { border-left: 4px solid #0ea5e9; }
    .card-aile { border-left: 4px solid #a855f7; }
    .login-routing-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .login-routing-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        min-width: 0;
    }
    .login-routing-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .box-sistemik {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .box-ftr {
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.3);
    }
    .box-aile {
        background: rgba(168, 85, 247, 0.15);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.3);
    }
    .login-routing-title-wrap {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }
    .login-routing-title {
        font-size: 15.5px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.2px;
    }
    .login-routing-sub {
        font-size: 11.5px;
        color: #94a3b8;
        font-weight: 500;
    }
    .login-routing-desc {
        font-size: 13px;
        color: #cbd5e1;
        line-height: 1.6;
        margin: 0;
    }
    .login-routing-specs {
        display: flex;
        flex-direction: column;
        gap: 8px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 12px;
        margin-top: 2px;
    }
    .login-routing-spec-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        font-size: 12px;
        line-height: 1.5;
    }
    .spec-label {
        width: 140px;
        flex-shrink: 0;
        color: #94a3b8;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
    }
    .spec-label i {
        font-size: 13px;
        opacity: 0.85;
    }
    .spec-val {
        flex: 1;
        color: #e2e8f0;
    }
    .spec-val.highlight-sistemik {
        color: #34d399;
        font-weight: 600;
    }
    .spec-val.highlight-ftr {
        color: #38bdf8;
        font-weight: 600;
    }
    .spec-val.highlight-aile {
        color: #c084fc;
        font-weight: 600;
    }
    .login-routing-score {
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 0.05em;
        flex-shrink: 0;
    }
    .score-sistemik {
        background: rgba(16, 185, 129, 0.18);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }
    .score-ftr {
        background: rgba(14, 165, 233, 0.18);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.4);
    }
    .score-aile {
        background: rgba(168, 85, 247, 0.18);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.4);
    }

    /* Light Theme Overrides */
    [data-theme="light"] .login-routing-card {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-top: 1.5px solid #ffffff;
        box-shadow: 0 16px 36px -8px rgba(14, 165, 233, 0.12), inset 0 1px 0 #ffffff;
    }
    [data-theme="light"] .card-sistemik { border-left: 4px solid #059669; }
    [data-theme="light"] .card-ftr { border-left: 4px solid #0284c7; }
    [data-theme="light"] .card-aile { border-left: 4px solid #7c3aed; }
    [data-theme="light"] .box-sistemik {
        background: rgba(16, 185, 129, 0.12);
        color: #059669;
        border-color: rgba(16, 185, 129, 0.25);
    }
    [data-theme="light"] .box-ftr {
        background: rgba(14, 165, 233, 0.12);
        color: #0284c7;
        border-color: rgba(14, 165, 233, 0.25);
    }
