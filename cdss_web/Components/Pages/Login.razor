@page "/login"
@layout EmptyLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Giriş — SEDA</PageTitle>

<div class="login-split-wrapper">

    <div class="login-split-left">
        <div class="login-split-brand" style="display:flex; flex-direction:column; align-items:flex-start;">
            <img src="seda-logo.jpg?v=2.1" alt="SEDA Logo" class="login-split-logo" />
            <span class="seda-animated-logo-text">SEDA</span>
            <span class="seda-animated-subtitle">SEDEF DESTEK ALGORİTMASI</span>
        </div>

        <div class="login-split-hero">
            <h1 class="login-split-title">Psoriazis Yönlendirme<br />Sistemi</h1>
            <p class="login-split-subtitle">
                Hastanın klinik bulgularını analiz ederek Sistemik Tedavi, FTR veya Aile Hekimliği ihtiyacını saniyeler içinde değerlendiren yapay zeka tabanlı karar destek asistanınız.
            </p>

            <!-- ─── Sıvı Cam Segmentli Kaydırıcı (Pulsar Glass Slider) ─── -->
            <div class="login-routing-slider-wrap">
                <div class="rag-segmented-track login-routing-track" id="loginRoutingTrack">
                    <div class="rag-active-slider" id="loginRoutingSlider"></div>
                    <button type="button" class="rag-pill-btn @(_aktifYonlendirme == "sistemik" ? "active" : "")"
                            @onclick='() => SetYonlendirme("sistemik")'>
                        <span class="rag-pill-label">
                            <i class="ph-bold ph-pill"></i> Sistemik Tedavi
                        </span>
                    </button>
                    <button type="button" class="rag-pill-btn @(_aktifYonlendirme == "ftr" ? "active" : "")"
                            @onclick='() => SetYonlendirme("ftr")'>
                        <span class="rag-pill-label">
                            <i class="ph-bold ph-person-arms-spread"></i> FTR &amp; Romatoloji
                        </span>
                    </button>
                    <button type="button" class="rag-pill-btn @(_aktifYonlendirme == "aile" ? "active" : "")"
                            @onclick='() => SetYonlendirme("aile")'>
                        <span class="rag-pill-label">
                            <i class="ph-bold ph-heartbeat"></i> Aile Hekimliği
                        </span>
                    </button>
                </div>
            </div>

            <!-- ─── Dinamik Seçili Yönlendirme Kartı (Pulsar Glass Klinik Karar Matrisi) ─── -->
            <div class="login-routing-card-container">
                @if (_aktifYonlendirme == "sistemik")
                {
                    <div class="login-routing-card card-sistemik fade-in">
                        <!-- Kart Başlığı & Pulsar Glass Metrik Hapı -->
                        <div class="routing-card-header">
                            <div class="routing-header-main">
                                <div class="routing-icon-capsule capsule-sistemik">
                                    <i class="ph-duotone ph-pill"></i>
                                </div>
                                <div class="routing-title-group">
                                    <h3 class="routing-card-title">Sistemik &amp; Biyolojik Tedavi</h3>
                                    <span class="routing-card-sub">Orta-Ağır Plak Psoriazis Karar Protokolü</span>
                                </div>
                            </div>
                            <span class="routing-score-text">%98.4 Doğruluk</span>
                        </div>

                        <!-- Klinik Özet -->
                        <p class="routing-card-desc">
                            Konvansiyonel sistemik ilaçlar ve hedefe yönelik biyolojik ajanların (Anti-IL17, IL-23, TNF-α) endikasyon, kontrendikasyon ve basamaklı geçiş kriterlerini değerlendirir.
                        </p>

                        <!-- Algoritmik Tetikleyici Eşikler (Pulsar Glass Chips) -->
                        <div class="routing-triggers-panel">
                            <div class="triggers-panel-header">
                                <i class="ph-bold ph-target"></i>
                                <span>Algoritmik Karar Eşikleri</span>
                            </div>
                            <div class="triggers-chips-wrap">
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-check"></i> PASI &gt; 10</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-check"></i> DLQI &gt; 10</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-check"></i> BSA &gt; %10</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-warning-circle"></i> Dirençli Özel Bölge</span>
                            </div>
                        </div>

                        <!-- 2 Kolonlu Yapılandırılmış Klinik Matris -->
                        <div class="routing-matrix-grid">
                            <div class="matrix-tile">
                                <div class="matrix-tile-header">
                                    <i class="ph-bold ph-sliders-horizontal"></i>
                                    <span>İncelenen Klinik Belirteçler</span>
                                </div>
                                <ul class="matrix-tile-list">
                                    <li><i class="ph-bold ph-caret-right"></i> Lezyon yaygınlığı ve şiddeti (PASI / BSA)</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Yaşam kalitesi ve psikososyal etki (DLQI)</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Önceki tedavi yanıtı ve basamak direnci</li>
                                </ul>
                            </div>
                            <div class="matrix-tile">
                                <div class="matrix-tile-header">
                                    <i class="ph-bold ph-shield-check"></i>
                                    <span>Hedef Çıktı &amp; Standart</span>
                                </div>
                                <ul class="matrix-tile-list">
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Biyolojik/Sistemik basamak uygunluk onayı</li>
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Karaciğer, böbrek ve enfeksiyon güvenlik denetimi</li>
                                </ul>
                                <div class="matrix-guideline-tags">
                                    <span class="guideline-tag"><i class="ph-bold ph-bookmark-simple"></i> 🇹🇷 TR PSOKİD 2025</span>
                                    <span class="guideline-tag"><i class="ph-bold ph-bookmark-simple"></i> 🇪🇺 EuroGuiDerm</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_aktifYonlendirme == "ftr")
                {
                    <div class="login-routing-card card-ftr fade-in">
                        <!-- Kart Başlığı & Pulsar Glass Metrik Hapı -->
                        <div class="routing-card-header">
                            <div class="routing-header-main">
                                <div class="routing-icon-capsule capsule-ftr">
                                    <i class="ph-duotone ph-person-arms-spread"></i>
                                </div>
                                <div class="routing-title-group">
                                    <h3 class="routing-card-title">Fizik Tedavi &amp; Romatoloji</h3>
                                    <span class="routing-card-sub">Erken Psöriatik Artrit (PsA) &amp; Eklem Hasarı Protokolü</span>
                                </div>
                            </div>
                            <span class="routing-score-text">%97.8 Doğruluk</span>
                        </div>

                        <!-- Klinik Özet -->
                        <p class="routing-card-desc">
                            Psöriatik artrit (PsA), aksiyel tutulum ve periferik eklem hasarını kalıcı erozyon gelişmeden önce erken evrede tespit ederek multidisipliner konsültasyon ihtiyacını belirler.
                        </p>

                        <!-- Algoritmik Tetikleyici Eşikler (Pulsar Glass Chips) -->
                        <div class="routing-triggers-panel">
                            <div class="triggers-panel-header">
                                <i class="ph-bold ph-target"></i>
                                <span>Algoritmik Karar Eşikleri</span>
                            </div>
                            <div class="triggers-chips-wrap">
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-clock"></i> Sabah Tutukluğu &gt; 30 dk</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-check"></i> CASPAR &ge; 3</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-warning-circle"></i> Daktilit (Sosis Parmak)</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-warning-circle"></i> Tırnak Tutulumu (NAPSI)</span>
                            </div>
                        </div>

                        <!-- 2 Kolonlu Yapılandırılmış Klinik Matris -->
                        <div class="routing-matrix-grid">
                            <div class="matrix-tile">
                                <div class="matrix-tile-header">
                                    <i class="ph-bold ph-sliders-horizontal"></i>
                                    <span>İncelenen Klinik Belirteçler</span>
                                </div>
                                <ul class="matrix-tile-list">
                                    <li><i class="ph-bold ph-caret-right"></i> İnflamatuar periferik ve aksiyel eklem ağrısı</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Sabah tutukluğu süresi ve daktilit öyküsü</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Tırnak distrofisi ve matriks tutulumu (NAPSI)</li>
                                </ul>
                            </div>
                            <div class="matrix-tile">
                                <div class="matrix-tile-header">
                                    <i class="ph-bold ph-shield-check"></i>
                                    <span>Hedef Çıktı &amp; Standart</span>
                                </div>
                                <ul class="matrix-tile-list">
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Erken Romatoloji/FTR konsültasyon sevk önceliği</li>
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Eklem hasarını önleyici hedefe yönelik tedavi planı</li>
                                </ul>
                                <div class="matrix-guideline-tags">
                                    <span class="guideline-tag"><i class="ph-bold ph-bookmark-simple"></i> CASPAR Kriterleri</span>
                                    <span class="guideline-tag"><i class="ph-bold ph-bookmark-simple"></i> EULAR / GRAPPA 2024</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="login-routing-card card-aile fade-in">
                        <!-- Kart Başlığı & Pulsar Glass Metrik Hapı -->
                        <div class="routing-card-header">
                            <div class="routing-header-main">
                                <div class="routing-icon-capsule capsule-aile">
                                    <i class="ph-duotone ph-heartbeat"></i>
                                </div>
                                <div class="routing-title-group">
                                    <h3 class="routing-card-title">Aile Hekimliği &amp; Komorbidite</h3>
                                    <span class="routing-card-sub">Kardiyometabolik Risk &amp; Birinci Basamak İzlemi</span>
                                </div>
                            </div>
                            <span class="routing-score-text">%96.1 Doğruluk</span>
                        </div>

                        <!-- Klinik Özet -->
                        <p class="routing-card-desc">
                            Psoriazisin kronik sistemik inflamatuar yapısı gereği tetiklenen kardiyometabolik riskleri, karaciğer fonksiyonlarını ve metabolik sendrom bileşenlerini koordine eder.
                        </p>

                        <!-- Algoritmik Tetikleyici Eşikler (Pulsar Glass Chips) -->
                        <div class="routing-triggers-panel">
                            <div class="triggers-panel-header">
                                <i class="ph-bold ph-target"></i>
                                <span>Algoritmik Karar Eşikleri</span>
                            </div>
                            <div class="triggers-chips-wrap">
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-warning"></i> VKİ &ge; 30 kg/m²</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-warning"></i> LDL &gt; 130 mg/dL</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-check"></i> Aktif Sigara</span>
                                <span class="pg-trigger-chip seda-flow-chip"><i class="ph-bold ph-heart"></i> Kardiyovasküler Risk</span>
                            </div>
                        </div>

                        <!-- 2 Kolonlu Yapılandırılmış Klinik Matris -->
                        <div class="routing-matrix-grid">
                            <div class="matrix-tile">
                                <div class="matrix-tile-header">
                                    <i class="ph-bold ph-sliders-horizontal"></i>
                                    <span>İncelenen Klinik Belirteçler</span>
                                </div>
                                <ul class="matrix-tile-list">
                                    <li><i class="ph-bold ph-caret-right"></i> Vücut Kitle İndeksi (VKİ) ve obezite evresi</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Serum lipid paneli (LDL/HDL/Trigliserit)</li>
                                    <li><i class="ph-bold ph-caret-right"></i> Karaciğer enzimleri (ALT/AST), sigara ve yaş</li>
                                </ul>
                            </div>
                            <div class="matrix-tile">
                                <div class="matrix-tile-header">
                                    <i class="ph-bold ph-shield-check"></i>
                                    <span>Hedef Çıktı &amp; Standart</span>
                                </div>
                                <ul class="matrix-tile-list">
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Birinci basamak metabolik takip ve statin protokolü</li>
                                    <li><i class="ph-bold ph-arrow-circle-right"></i> Sistemik ilaç hepatotoksisite ve risk yönetimi</li>
                                </ul>
                                <div class="matrix-guideline-tags">
                                    <span class="guideline-tag"><i class="ph-bold ph-bookmark-simple"></i> Türkiye KMR Kılavuzu</span>
                                    <span class="guideline-tag"><i class="ph-bold ph-bookmark-simple"></i> DSÖ Kardiyometabolik</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="login-split-watermark">
            <i class="ph ph-first-aid"></i>
        </div>
    </div>
 
    <div class="login-split-right">
        <div class="login-top-actions">
            <div class="rag-segmented-track login-theme-track" id="loginThemeTrack">
                <div class="rag-active-slider" id="loginActiveSlider"></div>
                <button type="button" class="rag-pill-btn @(_isDarkTheme ? "active" : "")"
                        @onclick="() => SetTheme(true)" title="Koyu Tema">
                    <span class="rag-pill-label">
                        <i class="ph-bold ph-moon"></i> Koyu
                    </span>
                </button>
                <button type="button" class="rag-pill-btn @(!_isDarkTheme ? "active" : "")"
                        @onclick="() => SetTheme(false)" title="Açık Tema">
                    <span class="rag-pill-label">
                        <i class="ph-bold ph-sun"></i> Açık
                    </span>
                </button>
            </div>
        </div>

        <div class="login-split-form-wrap">

            @if (_reason == "timeout")
            {
                <div class="login-banner login-banner--warning">
                    <i class="ph ph-clock"></i>
                    <span>Oturumunuz 30 dakika hareketsizlik nedeniyle sonlandırıldı.</span>
                </div>
            }
            else if (_reason == "unauthorized")
            {
                <div class="login-banner login-banner--error">
                    <i class="ph ph-lock"></i>
                    <span>Bu sayfaya erişmek için önce giriş yapmanız gerekiyor.</span>
                </div>
            }
            else if (_reason == "logout")
            {
                <div class="login-banner login-banner--success">
                    <i class="ph ph-check-circle"></i>
                    <span>Oturumunuz başarıyla sonlandırıldı. Güle güle!</span>
                </div>
            }

            <h2 class="login-split-heading">Hoş Geldiniz</h2>
            <p class="login-split-sub">Hesabınıza giriş yapın</p>

            @if (!string.IsNullOrEmpty(_hataMesaji))
            {
                <div class="login-banner login-banner--error" style="margin-bottom:20px;">
                    <i class="ph ph-warning"></i>
                    <span>@_hataMesaji</span>
                </div>
            }

            <EditForm Model="_form" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="login-underline-field">
                    <label class="login-underline-label">Kullanıcı Adı</label>
                    <InputText class="login-underline-input"
                               placeholder="kullanici.adi"
                               @bind-Value="_form.KullaniciAdi"
                               autocomplete="username" />
                    <ValidationMessage For="@(() => _form.KullaniciAdi)" />
                </div>

                <div class="login-underline-field">
                    <label class="login-underline-label">Şifre</label>
                    <input class="login-underline-input"
                           type="password"
                           placeholder="••••••••"
                           @bind="_form.Sifre"
                           @bind:event="oninput"
                           autocomplete="current-password" />
                </div>

                <button type="submit" class="login-split-btn" disabled="@_yukleniyor">
                    @if (_yukleniyor)
                    {
                        <span class="spinner" style="width:16px;height:16px;border-width:2px;border-color:rgba(255,255,255,0.3);border-top-color:#fff;"></span>
                        <span>Giriş yapılıyor…</span>
                    }
                    else
                    {
                        <span>Giriş Yap</span>
                        <i class="ph ph-arrow-right"></i>
                    }
                </button>
            </EditForm>

            <div class="login-split-security">
                <i class="ph ph-lock-simple"></i>
                <span>Güvenli bağlantı &middot; SSL şifreli</span>
            </div>
        </div>
    </div>
</div>

@code {
    private class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kullanıcı adı gerekli")]
        public string KullaniciAdi { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre gerekli")]
        public string Sifre { get; set; } = "";
    }

    private LoginForm _form = new();
    private string? _hataMesaji;
    private bool _yukleniyor;
    private bool _isDarkTheme = true;
    private string _aktifYonlendirme = "sistemik";

    [SupplyParameterFromQuery(Name = "reason")]
    private string? _reason { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? _returnUrl { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getSavedTheme");
                var isDark = (theme != "light");
                if (isDark != _isDarkTheme)
                {
                    _isDarkTheme = isDark;
                    StateHasChanged();
                }
                await JS.InvokeVoidAsync("initSegmentedSlider", "loginThemeTrack", "loginActiveSlider");
                await JS.InvokeVoidAsync("initSegmentedSlider", "loginRoutingTrack", "loginRoutingSlider");
            }
            catch { }

            var provider = (CustomAuthStateProvider)AuthStateProvider;
            var state = await provider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
                Nav.NavigateTo("/degerlendirme");
        }
        else
        {
            try
            {
                await JS.InvokeVoidAsync("updateSegmentedSlider", "loginThemeTrack", "loginActiveSlider");
                await JS.InvokeVoidAsync("updateSegmentedSlider", "loginRoutingTrack", "loginRoutingSlider");
            }
            catch { }
        }
    }

    private async Task SetYonlendirme(string mod)
    {
        if (_aktifYonlendirme == mod) return;
        _aktifYonlendirme = mod;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("updateSegmentedSlider", "loginRoutingTrack", "loginRoutingSlider");
        }
        catch { }
    }

    private async Task SetTheme(bool dark)
    {
        if (_isDarkTheme == dark) return;
        _isDarkTheme = dark;
        try
        {
            await JS.InvokeVoidAsync("setTheme", dark ? "dark" : "light");
            await JS.InvokeVoidAsync("updateSegmentedSlider", "loginThemeTrack", "loginActiveSlider");
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleTheme()
    {
        await SetTheme(!_isDarkTheme);
    }

    private async Task HandleLogin()
    {
        _yukleniyor = true;
        _hataMesaji = null;
        StateHasChanged();

        try
        {
            var provider = (CustomAuthStateProvider)AuthStateProvider;
            var basarili = await provider.GirisYapAsync(_form.KullaniciAdi, _form.Sifre);

            if (basarili)
            {
                var hedef = string.IsNullOrEmpty(_returnUrl) ? "/degerlendirme" : _returnUrl;
                Nav.NavigateTo(hedef, forceLoad: false);
            }
            else
            {
                _hataMesaji = "Kullanıcı adı veya şifre hatalı.";
            }
        }
        finally
        {
            _yukleniyor = false;
            StateHasChanged();
        }
    }
}
