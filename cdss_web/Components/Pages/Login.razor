@code {
    private class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kullanıcı adı gerekli")]
        public string KullaniciAdi { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre gerekli")]
        public string Sifre { get; set; } = "";
    }

    private LoginForm _form = new();
    private string? _hataMesaji;
    private bool _yukleniyor;
    private bool _isDarkTheme = true;
    private string _aktifYonlendirme = "sistemik";

    [SupplyParameterFromQuery(Name = "reason")]
    private string? _reason { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? _returnUrl { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getSavedTheme");
                var isDark = (theme != "light");
                if (isDark != _isDarkTheme)
                {
                    _isDarkTheme = isDark;
                    StateHasChanged();
                }
                await JS.InvokeVoidAsync("initSegmentedSlider", "loginThemeTrack", "loginActiveSlider");
                await JS.InvokeVoidAsync("initSegmentedSlider", "loginRoutingTrack", "loginRoutingSlider");
            }
            catch { }

            var provider = (CustomAuthStateProvider)AuthStateProvider;
            var state = await provider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
                Nav.NavigateTo("/degerlendirme");
        }
        else
        {
            try
            {
                await JS.InvokeVoidAsync("updateSegmentedSlider", "loginThemeTrack", "loginActiveSlider");
                await JS.InvokeVoidAsync("updateSegmentedSlider", "loginRoutingTrack", "loginRoutingSlider");
            }
            catch { }
        }
    }

    private async Task SetYonlendirme(string mod)
    {
        if (_aktifYonlendirme == mod) return;
        _aktifYonlendirme = mod;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("updateSegmentedSlider", "loginRoutingTrack", "loginRoutingSlider");
        }
        catch { }
    }

    private async Task SetTheme(bool dark)
    {
        if (_isDarkTheme == dark) return;
        _isDarkTheme = dark;
        try
        {
            await JS.InvokeVoidAsync("setTheme", dark ? "dark" : "light");
            await JS.InvokeVoidAsync("updateSegmentedSlider", "loginThemeTrack", "loginActiveSlider");
            StateHasChanged();
        }
        catch { }
    }

    private async Task ToggleTheme()
    {
        await SetTheme(!_isDarkTheme);
    }

    private async Task HandleLogin()
    {
        _yukleniyor = true;
        _hataMesaji = null;
        StateHasChanged();

        try
        {
            var provider = (CustomAuthStateProvider)AuthStateProvider;
            var basarili = await provider.GirisYapAsync(_form.KullaniciAdi, _form.Sifre);

            if (basarili)
            {
                var hedef = string.IsNullOrEmpty(_returnUrl) ? "/degerlendirme" : _returnUrl;
                Nav.NavigateTo(hedef, forceLoad: false);
            }
            else
            {
                _hataMesaji = "Kullanıcı adı veya şifre hatalı.";
            }
        }
        finally
        {
            _yukleniyor = false;
            StateHasChanged();
        }
    }
}
