@page "/degerlendirme"
@layout MainLayout
@inject CdssApiService ApiService
@inject PdfReportService PdfService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>CDSS — Hasta Değerlendirme</PageTitle>

<div class="page-header">
    <h2>Hasta Değerlendirme</h2>
    <p>Klinik bulgularını girerek sistemin yönlendirme önerisini alın.</p>
</div>

@if (_errorMessage is not null)
{
    <div class="alert alert-error">
        <span><i class="ph-bold ph-warning"></i></span>
        <span>@_errorMessage</span>
    </div>
}

<!-- ─── FORM ─────────────────────────────────────────────────────────────────── -->
@if (!_showResult)
{
    <div class="card fade-in">
        <div class="card-title">Hasta Bilgileri</div>

        <EditForm Model="_patient" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <!-- Hasta Bilgileri — Açılır/Kapanır -->
            <div class="collapsible-section" style="margin-bottom:20px;">
                <button type="button" class="collapsible-header" @onclick="@(() => _kimlikAcik = !_kimlikAcik)">
                    <span style="display:flex;align-items:center;gap:8px;">
                        <i class="ph ph-user"></i>
                        Hasta Bilgileri
                        <span style="font-size:12px;font-weight:500;color:var(--text-secondary);font-style:italic;">(isteğe bağlı)</span>
                        @if (!string.IsNullOrWhiteSpace(_patient.HastaAdi))
                        {
                            <span style="font-size:11px;color:var(--accent);">· @_patient.HastaAdi</span>
                        }
                    </span>
                    <i class="ph @(_kimlikAcik ? "ph-caret-up" : "ph-caret-down")" style="color:var(--text-muted);"></i>
                </button>

                @if (_kimlikAcik)
                {
                    <div class="collapsible-body fade-in">
                        <div class="form-grid" style="margin-bottom:16px;">
                            <div class="form-group">
                                <label class="form-label">Ad Soyad</label>
                                <InputText class="form-input"
                                           placeholder="Klinikteki dosya adı veya kod isim…"
                                           @bind-Value="_patient.HastaAdi" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Cinsiyet</label>
                                <select class="form-input" @bind="_cinsiyet">
                                    <option value="">Belirtilmedi</option>
                                    <option value="Erkek">Erkek</option>
                                    <option value="Kadın">Kadın</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-grid" style="margin-bottom:16px;">
                            <div class="form-group">
                                <label class="form-label">
                                    Doğum Tarihi
                                    <span style="color:var(--text-muted);font-weight:400;font-size:11px;">yaş otomatik hesaplanır</span>
                                </label>
                                <input type="date" class="form-input"
                                       value="@_dogumTarihi"
                                       @onchange="OnDogumTarihiChanged" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">İlk Psoriazis Tanı Tarihi</label>
                                <input type="date" class="form-input"
                                       value="@_ilkTaniTarihi"
                                       @onchange="@(e => _ilkTaniTarihi = e.Value?.ToString())" />
                            </div>
                        </div>

                    </div>
                }
            </div>

            <hr style="border:none;border-top:1px solid var(--border);margin:0 0 20px;" />


            <div class="form-grid" style="margin-bottom:20px;">
                <div class="form-group full-width">
                    <label class="form-label">Psoriazis Tipi</label>
                    <InputSelect class="form-input" @bind-Value="_patient.PsoriazisTipi">
                        <option value="Plak">Plak Psoriazis (En Sık)</option>
                        <option value="Guttat">Guttat Psoriazis</option>
                        <option value="Püstüler">Püstüler Psoriazis</option>
                        <option value="Eritrodermik">Eritrodermik Psoriazis</option>
                        <option value="Ters">İnvers (Ters) Psoriazis</option>
                    </InputSelect>
                    <ValidationMessage class="validation-message" For="@(() => _patient.PsoriazisTipi)" />
                </div>
            </div>

            <!-- Klinik Bulgular -->
            <div style="margin-bottom:20px;">
                <div class="card-title" style="margin-bottom:12px;">Klinik Bulgular</div>
                <div class="toggle-group">
                    <label class="toggle-row @(_patient.TirnakTutulumu ? "active" : "")">
                        <div class="toggle-label">
                            <strong>Tırnak Tutulumu</strong>
                            <small>Onikoliz, hiperkeratoz, subungual debris vb.</small>
                        </div>
                        <div class="toggle-switch">
                            <InputCheckbox @bind-Value="_patient.TirnakTutulumu" />
                            <span class="toggle-track"></span>
                        </div>
                    </label>

                    <label class="toggle-row @(_patient.SabahTuruklugu30dk ? "active" : "")">
                        <div class="toggle-label">
                            <strong>Sabah Tutukluğu &gt; 30 dk</strong>
                            <small>30 dakikadan uzun süren sabah katılığı</small>
                        </div>
                        <div class="toggle-switch">
                            <InputCheckbox @bind-Value="_patient.SabahTuruklugu30dk" />
                            <span class="toggle-track"></span>
                        </div>
                    </label>

                    <label class="toggle-row @(_patient.Sigara ? "active" : "")">
                        <div class="toggle-label">
                            <strong>Aktif Sigara Kullanımı</strong>
                            <small>Hâlihazırda sigara kullanan hasta</small>
                        </div>
                        <div class="toggle-switch">
                            <InputCheckbox @bind-Value="_patient.Sigara" />
                            <span class="toggle-track"></span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Ölçüm Değerleri -->
            <div class="card-title" style="margin-bottom:12px;">Ölçüm Değerleri</div>
            <div class="form-grid" style="margin-bottom:20px;">

                <div class="form-group">
                    <label class="form-label">
                        PASI Skoru <span>(0 – 72)</span>
                    </label>
                    <InputNumber class="form-input"
                                 placeholder="Örn: 7.5"
                                 @bind-Value="_patient.PasiSkoru" />
                    <span class="form-hint">@PasiLabel(_patient.PasiSkoru)</span>
                    <ValidationMessage class="validation-message" For="@(() => _patient.PasiSkoru)" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        VKİ <span>(kg/m²)</span>
                    </label>
                    <InputNumber class="form-input"
                                 placeholder="Örn: 28.5"
                                 @bind-Value="_patient.Vki" />
                    <span class="form-hint">@VkiLabel(_patient.Vki)</span>
                    <ValidationMessage class="validation-message" For="@(() => _patient.Vki)" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        LDL Kolesterol <span>(mg/dL)</span>
                    </label>
                    <InputNumber class="form-input"
                                 placeholder="Örn: 130"
                                 @bind-Value="_patient.Ldl" />
                    <span class="form-hint">@LdlLabel(_patient.Ldl)</span>
                    <ValidationMessage class="validation-message" For="@(() => _patient.Ldl)" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        DLQI <span>(0 – 30, opsiyonel)</span>
                    </label>
                    <InputNumber class="form-input"
                                 placeholder="Boş bırakılabilir"
                                 @bind-Value="_patient.Dlqi" />
                    <span class="form-hint">@DlqiLabel(_patient.Dlqi)</span>
                    <ValidationMessage class="validation-message" For="@(() => _patient.Dlqi)" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        BSA % <span>(opsiyonel)</span>
                    </label>
                    <InputNumber class="form-input"
                                 placeholder="Boş bırakılabilir"
                                 @bind-Value="_patient.Bsa" />
                    <span class="form-hint">@BsaLabel(_patient.Bsa)</span>
                    <ValidationMessage class="validation-message" For="@(() => _patient.Bsa)" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Yaş <span>(opsiyonel)</span>
                    </label>
                    <InputNumber class="form-input"
                                 placeholder="Boş bırakılabilir"
                                 @bind-Value="_patient.Yas" />
                    <span class="form-hint">@YasLabel(_patient.Yas)</span>
                    <ValidationMessage class="validation-message" For="@(() => _patient.Yas)" />
                </div>

            </div>

            <!-- Hekim Notu -->
            <div class="form-group" style="margin-bottom:24px;">
                <label class="form-label">
                    Hekim Notu
                    <span style="font-size:12px;font-weight:500;color:var(--text-secondary);font-style:italic;">(isteğe bağlı)</span>
                </label>
                <textarea class="form-input"
                          placeholder="Klinik gözlemler, ek notlar (Bu not PDF raporuna eklenecektir)…"
                          rows="3"
                          @bind="_hekimNotu"
                          style="resize:vertical;"></textarea>
            </div>

            <!-- Submit -->
            <div style="display:flex;gap:12px;align-items:center;">
                <button type="submit" class="btn btn-primary" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner" style="width:16px;height:16px;border-width:2px;"></span>
                        <span>Değerlendiriliyor…</span>
                    }
                    else
                    {
                        <span>🔬</span>
                        <span>Değerlendir</span>
                    }
                </button>
                <button type="button" class="btn btn-ghost" @onclick="ResetForm">
                    Temizle
                </button>
            </div>

        </EditForm>
    </div>
}

<!-- ─── SONUÇ ──────────────────────────────────────────────────────────────── -->
@if (_showResult && _result is not null)
{
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;" class="fade-in">
        <div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text-primary);">
                Değerlendirme Sonucu
            </h3>
            <p style="font-size:13px;color:var(--text-secondary);margin-top:2px;">
                @if (!string.IsNullOrWhiteSpace(_patient.HastaAdi))
                {
                    <span>Hasta: <strong style="color:var(--accent);">@_patient.HastaAdi</strong> &nbsp;·&nbsp; </span>
                }
                Audit #@_result.AuditId
                &nbsp;·&nbsp; @_result.IslemSuresiMs?.ToString("F0") ms
            </p>
            <p style="font-size:12px;color:var(--text-secondary);margin-top:4px;">
                Tip: <strong>@_patient.PsoriazisTipi</strong> &nbsp;·&nbsp;
                Yaş: <strong>@(_patient.Yas.HasValue ? _patient.Yas.ToString() : "Girilmedi")</strong> &nbsp;·&nbsp;
                BSA: <strong>@(_patient.Bsa.HasValue ? $"%{_patient.Bsa}" : "Girilmedi")</strong> &nbsp;·&nbsp;
                DLQI: <strong>@(_patient.Dlqi.HasValue ? _patient.Dlqi.ToString() : "Girilmedi")</strong>
            </p>
        </div>
        <div style="display:flex;gap:8px;">
            <button class="btn btn-ghost btn-sm" @onclick="DownloadPdf" disabled="@_pdfYukleniyor"
                    title="Klinik karar raporunu PDF olarak indir">
                @if (_pdfYukleniyor)
                {
                    <span class="spinner" style="width:14px;height:14px;border-width:2px;"></span>
                    <span>Hazırlanıyor…</span>
                }
                else
                {
                    <span>📄</span>
                    <span>Raporu İndir</span>
                }
            </button>
            <button class="btn btn-ghost btn-sm" @onclick="ResetForm">
                ← Yeni Değerlendirme
            </button>
        </div>
    </div>

    @if (_patient.PasiSkoru > 20)
    {
        <div style="background:rgba(239, 68, 68, 0.1);border-left:4px solid var(--danger);padding:16px;border-radius:4px;margin-bottom:20px;" class="fade-in">
            <h4 style="margin:0 0 8px;color:var(--danger);font-size:15px;display:flex;align-items:center;gap:8px;">
                <span><i class="ph-fill ph-warning-circle"></i></span> ACİL DERMATOLOJİ UYARISI
            </h4>
            <p style="margin:0;font-size:13px;color:var(--text-primary);line-height:1.5;">
                Hastanın PASI skoru oldukça yüksek (&gt;20). Eritrodermik veya çok şiddetli psoriazis şüphesi olabilir. Acil tıbbi müdahale ve/veya sistemik tedaviye hızlı başlangıç gerekebilir. Lütfen hastayı önceliklendiriniz.
            </p>
        </div>
    }

    <!-- 3 Label Kartı -->
    <div class="result-grid">
        @foreach (var card in BuildLabelCards(_result))
        {
            <div class="result-card @(card.Karar ? "positive" : "negative") fade-in">

                <div class="result-card-header">
                    <span class="result-card-icon">@LabelIcon(card.Key)</span>
                    <span class="result-badge @(card.Karar ? "badge-yes" : "badge-no")">
                        @(card.Karar ? "ÖNERİLİYOR" : "GEREKLİ DEĞİL")
                    </span>
                </div>

                <div class="result-card-title">@card.GoruntuAdi</div>

                <!-- Olasılık barı -->
                <div class="prob-row">
                    <div class="prob-bar-bg">
                        <div class="prob-bar-fill @(card.Karar ? "positive-fill" : "negative-fill")"
                             style="width:@(card.OlasilikYuzde)%">
                        </div>
                    </div>
                    <span class="prob-label @(card.Karar ? "positive-text" : "negative-text")">
                        %@card.OlasilikYuzde
                    </span>
                </div>

                <!-- SHAP Faktörler -->
                @if (card.TopFaktorler.Any())
                {
                    <div class="shap-section-title">Etkili Faktörler</div>
                    <div class="shap-list">
                        @foreach (var f in card.TopFaktorler.Take(4))
                        {
                            <div class="shap-item">
                                <div class="shap-item-label">
                                    <span>@f.Ozellik</span>
                                    <span>@(f.ShapDegeri > 0 ? "▲" : "▼") @Math.Abs(f.ShapDegeri).ToString("F3")</span>
                                </div>
                                <div class="shap-bar-bg">
                                    <div class="shap-bar-fill @(f.ShapDegeri >= 0 ? "shap-positive" : "shap-negative")"
                                         style="width:@(card.ShapBarWidth(f))%">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- LLM Açıklama -->
    @if (!string.IsNullOrWhiteSpace(_result.LlmAciklamasi))
    {
        <div id="llmBoxPanel" class="llm-box fade-in">
            <div class="llm-box-header">
                @if (_result.LlmFallbackUsed)
                {
                    <strong style="color:var(--warning);display:flex;align-items:center;gap:6px;"><i class="ph-bold ph-warning"></i> Şablon Açıklama (AI Sunucusuna Ulaşılamadı)</strong>
                    <span style="margin-left:auto;font-size:11px;color:var(--text-muted);">Sistem Şablonu</span>
                }
                else
                {
                    <strong style="display:flex;align-items:center;gap:6px;"><i class="ph-bold ph-robot"></i> Yapay Zeka Açıklaması</strong>
                    @if (!string.IsNullOrWhiteSpace(_result.LlmOzet))
                    {
                        <button type="button" class="btn-summarize" @onclick="ToggleOzet">
                            @if (_ozetGoster)
                            {
                                <i class="ph-bold ph-article" style="margin-right:5px;"></i><span>Tam Metni Göster</span>
                            }
                            else
                            {
                                <i class="ph-bold ph-lightning" style="margin-right:5px;"></i><span>Metni Özetle</span>
                            }
                        </button>
                    }
                }
            </div>
            <div class="llm-body-wrapper @(_ozetGoster ? "is-summary" : "is-detail")">
                <div class="llm-body-inner">
                    @if (_ozetGoster && !string.IsNullOrWhiteSpace(_result.LlmOzet))
                    {
                        <div class="llm-text summary-text fade-scale-in">
                            @_result.LlmOzet
                        </div>
                    }
                    else
                    {
                        <div class="llm-text detail-text fade-scale-in">
                            @_result.LlmAciklamasi
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Meta bilgi -->
    <div class="result-meta fade-in">
        <div class="meta-item">
            <small>Model</small>
            <span>@_result.ModelVersiyonu</span>
        </div>
        <div class="meta-item">
            <small>İşlem Süresi</small>
            <span>@(_result.IslemSuresiMs?.ToString("F1") ?? "-") ms</span>
        </div>
        <div class="meta-item">
            <small>Audit ID</small>
            <span>#@_result.AuditId</span>
        </div>
        <div class="meta-item">
            <small>Önerilen Birimler</small>
            <span>@(_result.AktifBirimler != null && _result.AktifBirimler.Any() ? string.Join(", ", _result.AktifBirimler) : "Hiçbiri (Doğrudan Sevk Gerekmez)")</span>
        </div>
    </div>
}

@code {
    private PatientInputModel _patient = new();
    private PredictionResponse? _result;
    private bool _loading = false;
    private bool _showResult = false;
    private string? _errorMessage;
    private bool _pdfYukleniyor = false;
    private string? _doktorAdi;

    // --- Accordion State ---
    private bool _kimlikAcik = false;
    private bool _ozetGoster = false;

    private async Task ToggleOzet()
    {
        _ozetGoster = !_ozetGoster;
        StateHasChanged();
        await JS.InvokeVoidAsync("animateHeightTransition", "llmBoxPanel", 450);
    }

    // --- İsteğe Bağlı Kimlik State ---
    private string _cinsiyet = "";
    private string? _dogumTarihi;
    private string? _ilkTaniTarihi;
    private string? _hekimNotu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _doktorAdi = state.User.Identity?.Name ?? "Bilinmeyen Hekim";
    }

    private void OnDogumTarihiChanged(ChangeEventArgs e)
    {
        _dogumTarihi = e.Value?.ToString();
        if (DateTime.TryParse(_dogumTarihi, out var dob))
        {
            var age = DateTime.Today.Year - dob.Year;
            if (dob.Date > DateTime.Today.AddYears(-age)) age--;
            _patient.Yas = age > 0 ? age : null;
        }
        else
        {
            _patient.Yas = null;
        }
    }

    private async Task HandleSubmit()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        var (result, error) = await ApiService.PredictAsync(_patient);
        _loading = false;

        if (error is not null)
        {
            _errorMessage = error;
        }
        else
        {
            _result = result;
            _showResult = true;
        }

        StateHasChanged();
    }

    private void ResetForm()
    {
        _patient = new();
        _cinsiyet = "";
        _dogumTarihi = null;
        _ilkTaniTarihi = null;
        _hekimNotu = null;
        _result = null;
        _showResult = false;
        _errorMessage = null;
        _ozetGoster = false;
    }

    private async Task DownloadPdf()
    {
        if (_result is null) return;

        _pdfYukleniyor = true;
        StateHasChanged();

        try
        {
            var pdfBytes = PdfService.GenerateReport(_result, _patient, _doktorAdi ?? "Hekim");
            var base64 = Convert.ToBase64String(pdfBytes);
            var dosyaAdi = $"CDSS_Rapor_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
            await JS.InvokeVoidAsync("downloadFile", dosyaAdi, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF oluşturulurken hata: {ex.Message}";
        }
        finally
        {
            _pdfYukleniyor = false;
            StateHasChanged();
        }
    }

    private static readonly string[] LabelOrder = ["ftr", "aile_hekimligi", "sistemik_tedavi"];

    private List<LabelCardModel> BuildLabelCards(PredictionResponse r)
    {
        var shapMap = r.ShapAciklamalari ?? new();
        var tahmin  = r.Tahmin ?? new();
        return LabelOrder
            .Where(k => tahmin.ContainsKey(k))
            .Select(k => new LabelCardModel
            {
                Key         = k,
                GoruntuAdi  = tahmin[k].GoruntuAdi ?? k,
                Karar       = tahmin[k].Karar,
                Olasilik    = tahmin[k].Olasilik,
                TopFaktorler = shapMap.TryGetValue(k, out var s) ? s.TopFaktorler : [],
            })
            .ToList();
    }

    private static MarkupString LabelIcon(string label) => new MarkupString(label switch
    {
        "ftr"             => "<i class=\"ph-duotone ph-person-simple-walk\"></i>",
        "aile_hekimligi"  => "<i class=\"ph-duotone ph-hospital\"></i>",
        "sistemik_tedavi" => "<i class=\"ph-duotone ph-pill\"></i>",
        _                 => "<i class=\"ph-bold ph-flask\"></i>",
    });

    private static string PasiLabel(double? v)
    {
        if (!v.HasValue) return "Değer giriniz";
        if (v <= 5)  return $"{v:F1} — Hafif";
        if (v <= 10) return $"{v:F1} — Orta şiddetli";
        return $"{v:F1} — Şiddetli (eşik: >10)";
    }

    private static string VkiLabel(double? v)
    {
        if (!v.HasValue) return "Değer giriniz";
        if (v < 18.5) return $"{v:F1} — Zayıf";
        if (v < 25)   return $"{v:F1} — Normal";
        if (v < 30)   return $"{v:F1} — Fazla kilolu";
        if (v < 35)   return $"{v:F1} — Obez (eşik: >30)";
        return $"{v:F1} — Morbid obez (eşik: >35)";
    }

    private static string LdlLabel(double? v)
    {
        if (!v.HasValue) return "Değer giriniz";
        if (v < 100) return $"{v:F0} mg/dL — Optimal";
        if (v < 130) return $"{v:F0} mg/dL — Normal üst sınır";
        if (v < 160) return $"{v:F0} mg/dL — Yüksek (eşik: >130)";
        return $"{v:F0} mg/dL — Çok yüksek (eşik: >160)";
    }

    private static string DlqiLabel(double? v)
    {
        if (!v.HasValue) return "Değer girilmedi (Opsiyonel)";
        if (v <= 5)  return $"{v:F0} — Hafif etki";
        if (v <= 10) return $"{v:F0} — Orta dereceli etki";
        return $"{v:F0} — Kritik etki (eşik: >10)";
    }

    private static string BsaLabel(double? v)
    {
        if (!v.HasValue) return "Değer girilmedi (Opsiyonel)";
        if (v <= 5)  return $"% {v:F0} — Hafif tutulum";
        if (v <= 10) return $"% {v:F0} — Orta yayılım";
        return $"% {v:F0} — Yaygın tutulum (eşik: >%10)";
    }

    private static string YasLabel(int? v)
    {
        if (!v.HasValue) return "Değer girilmedi (Opsiyonel)";
        if (v < 18) return $"{v} yaş — Pediatrik hasta";
        if (v < 40) return $"{v} yaş — Erken başlangıçlı psoriazis";
        return $"{v} yaş — Geç başlangıçlı / Yetişkin";
    }
}
