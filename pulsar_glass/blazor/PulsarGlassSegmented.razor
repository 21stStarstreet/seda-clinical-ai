@typeparam TItem
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    Pulsar Glass — Liquid Segmented Slider for Blazor
    Usage:
    <PulsarGlassSegmented TItem="string"
                          Items="@_options"
                          @bind-Value="_selected"
                          Size="PulsarGlassSize.Default" />
*@

<div class="pg-track @GetSizeClass() @Class" id="@_trackId" style="@Style">
    <div class="pg-slider" id="@_sliderId"></div>

    @if (Items != null)
    {
        int index = 0;
        foreach (var item in Items)
        {
            var currentIndex = index;
            var isCurrentActive = IsActive(item, currentIndex);
            var itemVal = GetItemValue(item);
            var itemTxt = GetItemText(item);
            var itemIco = ItemIcon?.Invoke(item);

            <button type="button"
                    class="pg-btn @(isCurrentActive ? "active" : "")"
                    data-value="@itemVal"
                    data-index="@currentIndex"
                    @onclick="() => OnButtonClicked(item, currentIndex)">
                <span class="pg-label">
                    @if (ItemTemplate != null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(itemIco))
                        {
                            <i class="@itemIco"></i>
                        }
                        <span>@itemTxt</span>
                    }
                </span>
            </button>
            index++;
        }
    }
</div>

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public TItem? Value { get; set; }
    [Parameter] public EventCallback<TItem> ValueChanged { get; set; }
    [Parameter] public EventCallback<TItem> OnChanged { get; set; }

    [Parameter] public Func<TItem, string>? ItemText { get; set; }
    [Parameter] public Func<TItem, string>? ItemValue { get; set; }
    [Parameter] public Func<TItem, string>? ItemIcon { get; set; }
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter] public PulsarGlassSize Size { get; set; } = PulsarGlassSize.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public int MaxOvershoot { get; set; } = 44;
    [Parameter] public int PullResistance { get; set; } = 110;
    [Parameter] public bool EnableRefraction { get; set; } = true;

    private readonly string _trackId = "pg-track-" + Guid.NewGuid().ToString("N")[..8];
    private readonly string _sliderId = "pg-slider-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<PulsarGlassSegmented<TItem>>? _dotNetRef;
    private IJSObjectReference? _jsInstance;
    private bool _initialized;
    private TItem? _prevValue;

    protected override void OnInitialized()
    {
        _prevValue = Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                // PulsarGlass.create() çağrısı ile JS fizik motorunu başlatıyoruz
                _jsInstance = await JS.InvokeAsync<IJSObjectReference>("PulsarGlass.create", $"#{_trackId}", new
                {
                    maxOvershoot = MaxOvershoot,
                    pullResistance = PullResistance,
                    enableRefraction = EnableRefraction,
                    dotNetHelper = _dotNetRef
                });
                _initialized = true;
            }
            catch (Exception ex)
            {
                // Sayfa ilk yüklenirken veya SSR esnasında hata vermemesi için koruma
                Console.WriteLine($"[PulsarGlass] Init warning: {ex.Message}");
            }
        }
        else if (_initialized && !EqualityComparer<TItem>.Default.Equals(Value, _prevValue))
        {
            _prevValue = Value;
            await SyncSliderPositionAsync();
        }
    }

    private async Task OnButtonClicked(TItem item, int index)
    {
        Value = item;
        _prevValue = item;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(item);
        }

        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync(item);
        }
    }

    [JSInvokable]
    public async Task OnJsSelectionChanged(int index, string value)
    {
        if (Items == null) return;
        var list = Items.ToList();
        if (index >= 0 && index < list.Count)
        {
            var selected = list[index];
            if (!EqualityComparer<TItem>.Default.Equals(Value, selected))
            {
                Value = selected;
                _prevValue = selected;

                if (ValueChanged.HasDelegate)
                    await ValueChanged.InvokeAsync(selected);

                if (OnChanged.HasDelegate)
                    await OnChanged.InvokeAsync(selected);

                StateHasChanged();
            }
        }
    }

    private async Task SyncSliderPositionAsync()
    {
        if (_jsInstance != null && Items != null)
        {
            var list = Items.ToList();
            var index = list.FindIndex(x => EqualityComparer<TItem>.Default.Equals(x, Value));
            if (index >= 0)
            {
                try
                {
                    await _jsInstance.InvokeVoidAsync("selectIndex", index, true);
                }
                catch { }
            }
        }
    }

    private bool IsActive(TItem item, int index)
    {
        if (Value != null)
        {
            return EqualityComparer<TItem>.Default.Equals(item, Value);
        }
        return index == 0;
    }

    private string GetItemText(TItem item)
    {
        if (ItemText != null) return ItemText(item);
        return item?.ToString() ?? string.Empty;
    }

    private string GetItemValue(TItem item)
    {
        if (ItemValue != null) return ItemValue(item);
        return item?.ToString() ?? string.Empty;
    }

    private string GetSizeClass() => Size switch
    {
        PulsarGlassSize.Small => "pg-sm",
        PulsarGlassSize.Large => "pg-lg",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsInstance != null)
            {
                await _jsInstance.InvokeVoidAsync("destroy");
                await _jsInstance.DisposeAsync();
            }
        }
        catch { }

        _dotNetRef?.Dispose();
    }
}
